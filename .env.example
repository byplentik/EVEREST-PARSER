APP_NAME=everest-parser
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=everest_parser
POSTGRES_USER=everest
POSTGRES_PASSWORD=everest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://everest:everest@db:5432/everest_parser

UC_HEADLESS=true
UC_ENABLE_CDP_EVENTS=true
UC_VERSION_MAIN=
UC_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
UC_USER_DATA_DIR=/tmp/uc-profile
UC_PAGE_LOAD_TIMEOUT_SECONDS=60

HTTP_TIMEOUT_SECONDS=30
HTTP_VERIFY_SSL=true
HTTP_PROXY_URL=
BROWSER_PROXY_URL=
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3

